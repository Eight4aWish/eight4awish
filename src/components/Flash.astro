---
// The no-compiler path. NOTE: the route depends on how the firmware is BUILT, not
// just on the platform — a Daisy BOOT_NONE build fits internal flash and flashes
// directly, while a BOOT_QSPI build runs from the QSPI chip via the Daisy bootloader
// and needs that installed once first.
import { inlineMd } from '../lib/inlineMd'

const { binary, version, binaryLabel, extras = [], flash = {} } = Astro.props


// Every word of this section comes from the page's own frontmatter - there is no wording
// in here to fall back on, deliberately, so nothing can be published that only a code edit
// can correct. A field left blank simply does not render.
const g = flash ?? {}
const steps = g.steps ?? []
const bootSteps = g.bootSteps ?? []

---
{binary && (
  <section class="flash">
    <h2 class="sec">Flash it — no compiler needed</h2>
    {g.intro && <p class="sub" set:html={inlineMd(g.intro)} />}

    {g.warn && <div class="warn"><b>Read this first —</b> <Fragment set:html={inlineMd(g.warn)} /></div>}

    <div class="dl">
      <a class="btn" href={binary}>Download {binaryLabel ?? 'firmware'}{version ? ` ${version}` : ''}</a>
      {extras.map((b) => (
        <a class="btn" href={b.url}>Download {b.label}{b.version ? ` ${b.version}` : ''}</a>
      ))}
      {(g.links ?? []).map((l) => (
        <a class="btn ghost" href={l.url} target="_blank" rel="noopener">{l.label}</a>
      ))}
    </div>

    {extras.length > 0 && (
      <p class="tiny">{g.extrasNote ?? 'These builds flash exactly the same way — the steps below apply to all of them. The only difference is which .bin you download and put on the card.'}</p>
    )}

    {bootSteps.length > 0 && (
      <>
        <h3 class="flashsub">{g.stepsTitle}</h3>
        <ol class="flashsteps">{bootSteps.map((s) => <li set:html={inlineMd(s)} />)}</ol>
        <h3 class="flashsub">Every time — load the firmware</h3>
      </>
    )}

    {steps.length > 0 && <ol class="flashsteps">{steps.map((s) => <li set:html={inlineMd(s)} />)}</ol>}

    {g.command && <pre><code>{g.command}</code></pre>}

    {g.note && <div class="note" set:html={inlineMd(g.note)} />}
  </section>
)}
