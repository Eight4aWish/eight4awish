---
// The three card shapes, in one place — change here, every grid follows.
import { opt } from '../lib/img'
const { modules = [], tutorials = [], notes = [] } = Astro.props
---
{modules.length > 0 && (
  <div class="grid">
    {modules.map((m) => (
      <a class="card" href={`/modules/${m.id}/`}>
        <div class="thumb"><img src={opt(m.data.panel)} alt={m.data.title} loading="lazy" decoding="async" /></div>
        <div class="body">
          <h3>{m.data.title}</h3>
          <p>{m.data.summary}</p>
          <div class="chips">
            <span class="chip acc">{m.data.platform}</span>
            {m.data.tags.map((t) => <span class="chip">{t}</span>)}
          </div>
        </div>
      </a>
    ))}
  </div>
)}

{tutorials.length > 0 && (
  <div class="grid tut">
    {tutorials.map((t) => (
      <a class="card" href={t.data.cta ?? `/tutorials/${t.id}/`}>
        <div class="thumb"><img src={opt(t.data.graphic)} alt={t.data.title} loading="lazy" decoding="async" /></div>
        <div class="body">
          <p class="eyebrow">{t.data.eyebrow}</p>
          <h3>{t.data.title}</h3>
          <p>{t.data.summary}</p>
          <div class="chips">
            {t.data.chips.map((c, i) => <span class={i === 0 ? 'chip acc' : 'chip'}>{c}</span>)}
          </div>
        </div>
      </a>
    ))}
  </div>
)}

{notes.length > 0 && (
  <div class="grid tut">
    {notes.map((n) => (
      <a class="card" href={`/notes/${n.id}/`}>
        {n.data.graphic && (
          <div class="thumb"><img src={opt(n.data.graphic)} alt={n.data.title} loading="lazy" decoding="async" /></div>
        )}
        <div class="body">
          <p class="eyebrow">{n.data.eyebrow}</p>
          <h3>{n.data.title}</h3>
          <p>{n.data.summary}</p>
          <div class="chips">
            {n.data.chips.map((c, i) => <span class={i === 0 ? 'chip acc' : 'chip'}>{c}</span>)}
          </div>
        </div>
      </a>
    ))}
  </div>
)}
