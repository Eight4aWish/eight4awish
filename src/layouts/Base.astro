---
import '../styles/site.css'
const {
  title,
  nav = '',
  description = 'DIY eurorack: firmware, panels, schematics and patches — all written as code.',
  image = '/renders/tut_panels.png',
} = Astro.props
const url = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url
const img = Astro.site ? new URL(image, Astro.site) : image
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>

<!-- so a link pasted into YouTube, Reddit or Discord shows the artwork -->
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={img}>
<meta property="og:url" content={url}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={img}>

<slot name="head" />
</head>
<body>

<header class="site"><div class="wrap">
  <a class="brand" href="/">Home</a>
  <nav class="site">
    <a href="/modules/" class={nav === 'modules' ? 'on' : undefined}>Modules</a>
    <a href="/tutorials/" class={nav === 'tutorials' ? 'on' : undefined}>Tutorials</a>
    <a href="/about/">About</a>
  </nav>
</div></header>

<main class="wrap"><slot /></main>

<footer class="site"><div class="wrap">
  <span>© Eight4aWish</span>
  <a href="https://github.com/Eight4aWish">GitHub</a>
  <a href="https://buymeacoffee.com/eight4awish">Buy me a coffee</a>
</div></footer>

</body>
</html>
