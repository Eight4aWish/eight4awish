---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import Cards from '../components/Cards.astro'
import home from '../content/home.json'   // edited in the CMS under Pages → Home page

const live = (c) => c.filter((e) => !e.data.draft)
const allModules = live(await getCollection('modules'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const tutorials = live(await getCollection('tutorials'))
  .sort((a, b) => a.data.order - b.data.order)
const latest = allModules.slice(0, home.latestCount)
// Notes get a strip rather than cards. They are short form and there are few of
// them; a row of 220px thumbnails would give them more of the page than the
// modules, which are the point of the site.
const notes = live(await getCollection('notes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, home.notesCount ?? 3)
---
<Base title="Eight4aWish — DIY Eurorack">

  <div class="intro">
    <h1>{home.heading}</h1>
    <p>{home.intro}</p>
    {home.tagline && <p class="tagline">{home.tagline}</p>}
  </div>

  <div class="sechead">
    <h2 class="sec">Tutorials</h2>
    <a class="seeall" href="/tutorials/">All tutorials →</a>
  </div>
  {home.tutorialsBlurb && <p class="sub">{home.tutorialsBlurb}</p>}
  <Cards tutorials={tutorials.slice(0, 3)} />

  <div class="sechead">
    <h2 class="sec">Latest modules</h2>
    <a class="seeall" href="/modules/">All {allModules.length} modules →</a>
  </div>
  <Cards modules={latest} />

  {allModules.length > latest.length && (
    <div class="morerow">
      <a class="btn ghost" href="/modules/">See all {allModules.length} modules →</a>
    </div>
  )}

  {notes.length > 0 && (
    <>
      <div class="sechead">
        <h2 class="sec">Notes</h2>
        <a class="seeall" href="/notes/">All notes →</a>
      </div>
      <ul class="notestrip">
        {notes.map((n) => (
          <li>
            <a href={`/notes/${n.id}/`}>
              {n.data.eyebrow && <span class="chip acc">{n.data.eyebrow}</span>}
              <strong>{n.data.title}</strong>
              <span class="sum">{n.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}

</Base>
