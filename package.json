{
  "name": "eight4awish",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "astro build",
    "deploy": "node tools/deploy.mjs",
    "dev": "astro dev",
    "edit": "astro dev --open /keystatic",
    "images": "node tools/optimise-images.mjs",
    "prebuild": "node tools/normalise-markdoc-tables.mjs && node tools/optimise-images.mjs",
    "predev": "node tools/normalise-markdoc-tables.mjs && npm run sync:lessons && npm run sync:renders",
    "preedit": "npm run sync:lessons && npm run sync:renders && node tools/normalise-markdoc-tables.mjs",
    "preview": "astro preview",
    "promote": "node tools/promote.mjs",
    "sync:lessons": "mkdir -p public/lessons && cp strudel/lessons/simple_song*.js public/lessons/",
    "sync:renders": "node tools/sync-renders.mjs",
    "tables": "node tools/normalise-markdoc-tables.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "@astrojs/react": "^6.0.1",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.5.51",
    "@markdoc/markdoc": "^0.5.7",
    "astro": "^7.0.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
